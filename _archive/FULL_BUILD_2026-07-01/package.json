{
  "name": "se-menu-test-console",
  "productName": "SE-MENU",
  "version": "1.0.0",
  "description": "SE-MENU — a premium system, network and UI testing console for Windows.",
  "main": "src/main/main.js",
  "author": "sside",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "selftest": "electron . --selftest",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "icon": "python scripts/make-icon.py",
    "fonts": "node scripts/install-fonts.js",
    "postinstall": "node scripts/install-fonts.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0"
  }
}
